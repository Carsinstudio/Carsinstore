# Copy this file to .env and fill it in.

# Port and the public address of your store (used for Paystack redirects and cookies).
PORT=3000
BASE_URL=http://localhost:3000

# Paystack — Settings > API Keys & Webhooks at https://dashboard.paystack.com
# Use sk_test_... while testing, then switch to sk_live_... when you go live.
# Set the webhook URL there to BASE_URL/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# Optional: email buyers their download link (and let them re-request lost links).
# Sign up free at https://resend.com, verify your domain, then fill these in.
RESEND_API_KEY=
EMAIL_FROM=Carsinstore <downloads@yourdomain.com>

# When Paystack is NOT set, "true" lets you click through a simulated checkout for testing.
# Set to false (or remove) before going live.
DEMO_CHECKOUT=true

# Set to 1 when hosting behind a proxy (Railway, Render, Nginx/Caddy) so rate limits see visitors' real IPs.
# Leave unset when the store is reached directly.
# TRUST_PROXY=1

# Largest single upload, in MB (videos can be big).
MAX_UPLOAD_MB=4096

# Optional: where the database and uploaded files live (defaults to ./storage).
# DATA_DIR=/var/data/carsinstore

# Optional: a long random string. One is generated automatically if left empty.
# SESSION_SECRET=
